# Copia este fichero a .env y ajusta. Sin DATABASE_URL se usa PGlite (PostgreSQL embebido) en ./data/pglite: no hace falta instalar nada.
# Para usar un PostgreSQL propio (p. ej. docker compose up -d db), quita el # de la línea siguiente:
# DATABASE_URL=postgres://vertice:vertice@localhost:5432/vertice
PORT=8080
ADMIN_TOKEN=cambia-esto
AMBIENT_NPCS=48
CROWD_NPCS=0
CROWD_AT=21,34
LINGER_SECONDS=10
VIEW_RADIUS=22
# Desplaza el reloj de la ciudad (horas). 1 hora de juego = 60 s reales (content/manifest.json).
CITY_HOUR_OFFSET=0
# v0.8.1 · La cuenta de administración del dueño («mataxhustaadmin») se crea siempre; su contraseña solo existe como hash en el código.
# v0.8 · Cuenta de pruebas «admintester» (todo desbloqueado y menú de trucos con º o F10).
# En local, si no pones nada, la contraseña es «admintester». En producción solo se crea si defines esta variable.
# ADMIN_TESTER_PASSWORD=pon-aqui-una-contraseña
# THREATS=0 desactiva maleantes, recompensas automáticas y ciberpsicópatas.
