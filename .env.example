# Copia este fichero a .env y ajusta. Sin DATABASE_URL se usa PGlite (PostgreSQL embebido) en ./data/pglite.
DATABASE_URL=postgres://vertice:vertice@localhost:5432/vertice
PORT=8080
ADMIN_TOKEN=cambia-esto
AMBIENT_NPCS=24
CROWD_NPCS=0
CROWD_AT=21,34
LINGER_SECONDS=10
VIEW_RADIUS=22
# Desplaza el reloj de la ciudad (horas). 1 hora de juego = 60 s reales (content/manifest.json).
CITY_HOUR_OFFSET=0
